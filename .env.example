# Backend local (nunca commite o .env). Sem estas variáveis o atendimento funciona só no app.
AGENT_RUNTIME=github-native
AGENT_DRY_RUN=true
GITHUB_REPO=luizlouren/fluxo-tarefas-treinamento
# Credencial local do backend: só criar/ler issues. Diferente do secret COPILOT_AGENT_TOKEN das Actions.
GITHUB_ISSUES_TOKEN=
